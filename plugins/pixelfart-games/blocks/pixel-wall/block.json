{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "pixelfart/pixel-wall",
	"title": "Pixelmuur",
	"category": "widgets",
	"icon": "grid-view",
	"description": "Muur met alle gekochte pixels. Klik op een pixel om te zien wie hem kocht. Op de doneerpagina kun je er ook pixels kopen.",
	"keywords": [
		"pixels",
		"doneren",
		"muur"
	],
	"textdomain": "pixelfart",
	"supports": {
		"html": false,
		"multiple": false,
		"align": [
			"wide"
		]
	},
	"editorScript": "file:./editor.js",
	"viewScript": "pixelfart-donate",
	"render": "file:./render.php",
	"attributes": {
		"title": {
			"type": "string",
			"default": "ONZE PIXELFANS"
		},
		"link": {
			"type": "boolean",
			"default": true
		}
	},
	"style": "pixelfart-wall"
}
