# wp-content-repo: alleen wat we zelf voor deze website maken.
# Plugins, thema's en vertalingen van anderen niet: die werken zichzelf bij (auto-updates).
# Alles wat WordPress of plugins zelf genereren ook niet.

# Plugins en thema's: alles negeren behalve onze eigen
/plugins/*
!/plugins/index.php
!/plugins/pixelfart-games/
/themes/*
!/themes/index.php
!/themes/pixelfart/

# Vertalingen: haalt WordPress zelf op en houdt het bij
/languages/

# Media
/uploads/

# Caches en tijdelijke bestanden
/cache/
/upgrade/
/upgrade-temp-backup/
/litespeed/
/et-cache/
/wflogs/

# Drop-ins die door plugins (per omgeving) worden geschreven
/advanced-cache.php
/object-cache.php
/db.php
/.litespeed_conf.dat
/.litespeed_conf.php

# Back-ups
/ai1wm-backups/
/updraft/
/backups/
/backup-db/

# Logs en systeembestanden
*.log
.DS_Store
Thumbs.db

# Privésleutels (o.a. Mollie-ondertekening) nooit in git
*.pem
